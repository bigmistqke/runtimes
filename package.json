{
  "name": "@nativescript/macos-node-api",
  "version": "0.4.4",
  "description": "An embeddable, engine-agnostic NativeScript runtime for macOS based on Node-API",
  "repository": {
    "type": "git",
    "url": "https://github.com/NativeScript/napi-ios.git",
    "directory": "packages/macos-node-api"
  },
  "main": "packages/macos-node-api/index.js",
  "typings": "packages/macos-node-api/index.d.ts",
  "type": "module",
  "files": [
    "./packages/macos-node-api/*.d.ts",
    "packages/macos-node-api/build/RelWithDebInfo/NativeScript.apple.node",
    "packages/macos-node-api/index.cjs",
    "packages/macos-node-api/index.d.ts",
    "packages/macos-node-api/index.mjs",
    "packages/macos-node-api/types"
  ],
  "scripts": {
    "build": "cd ../.. && ./scripts/build_all_react_native.sh",
    "prepare": "./scripts/build_all_ios.sh --no-engine --embed-metadata --macos --no-iphone --no-simulator",
    "metagen": "node scripts/metagen.js"
  },
  "keywords": [
    "AppKit",
    "macOS",
    "NativeScript"
  ],
  "contributors": [
    {
      "name": "DjDeveloperr"
    },
    {
      "name": "Jamie Birch"
    },
    {
      "name": "Nathan Walker"
    },
    {
      "name": "Eduardo Speroni"
    },
    {
      "name": "NativeScript",
      "email": "oss@nativescript.org"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@nativescript/objc-node-api": "^1.0.0-alpha.7"
  },
  "devDependencies": {
    "rimraf": "^6.0.0"
  },
  "exports": {
    ".": {
      "types": "./packages/macos-node-api/index.d.ts",
      "import": "./packages/macos-node-api/index.mjs",
      "require": "./packages/macos-node-api/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
